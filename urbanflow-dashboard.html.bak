<!DOCTYPE html>
<html lang="id"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-content">
<meta name="color-scheme" content="dark"><meta name="theme-color" content="#070706"><title>UrbanFlow · Dashboard CEO</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Instrument+Serif&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root{--bg:#070706;--tx:#efeeea;--mu:#9a998f;--ok:#3ddc97;--wa:#ffb547;--bad:#ff5c5c;--ac:#8fb4ff;--eo:cubic-bezier(.23,1,.32,1);--ed:cubic-bezier(.32,.72,0,1);--st:env(safe-area-inset-top,0px);--sb:env(safe-area-inset-bottom,0px);color-scheme:dark}
*{box-sizing:border-box}html{scroll-padding-top:90px;-webkit-tap-highlight-color:transparent;-webkit-text-size-adjust:100%;overscroll-behavior:none}body{font-variant-numeric:tabular-nums}button,a,[role=button]{touch-action:manipulation;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;transition:transform .14s var(--eo),background .2s var(--eo),color .2s var(--eo)}button:active{transform:scale(.97)}:focus-visible{outline:2px solid var(--ac);outline-offset:2px}.hm i{touch-action:manipulation}@media(pointer:coarse){input,select,textarea{font-size:16px!important}.hm i{height:22px}.hm{min-width:680px}}
body{margin:0;background:var(--bg);color:var(--tx);font:400 14px/1.45 Geist,"Plus Jakarta Sans",system-ui,sans-serif;min-height:100dvh;-webkit-tap-highlight-color:transparent;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(700px 420px at 85% -8%,rgba(255,244,225,.045),transparent)}
button,select,input{font:inherit;color:inherit}button{cursor:pointer;border:0;background:none;touch-action:manipulation}
.side{position:fixed;left:14px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:4px;padding:6px;border-radius:999px;background:rgba(20,20,28,.6);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.08);z-index:20}
.side a{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;color:var(--mu);transition:background .2s var(--eo),color .2s var(--eo),transform .15s var(--eo)}
.side a:active,.btn:active,.pill:active{transform:scale(.97)}.side svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.2;stroke-linecap:round;stroke-linejoin:round}
@media(hover:hover) and (pointer:fine){.side a:hover{background:rgba(255,255,255,.08);color:var(--tx)}}
main{max-width:1320px;margin:0 auto;padding:calc(var(--st) + 74px) 20px 110px 86px;position:relative}
.eb{display:inline-block;padding:4px 12px;border-radius:99px;background:rgba(255,255,255,.06);font-size:12px;color:var(--mu)}
h1{font:400 clamp(30px,4.4vw,54px)/1 "Instrument Serif",Georgia,serif;letter-spacing:-.025em;margin:14px 0 10px}h1 span{color:var(--mu)}
.bc{display:flex;gap:6px;flex-wrap:wrap;align-items:center;color:var(--mu);font-size:13px}.bc button{color:var(--mu);padding:4px 8px;border-radius:99px}.bc button:last-child{color:var(--tx);background:rgba(255,255,255,.07)}
.top{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:32px}
.seg{display:inline-flex;padding:3px;border-radius:12px;background:rgba(255,255,255,.06)}.seg button{padding:11px 16px;min-height:44px;border-radius:9px;color:var(--mu)}.seg button.on{background:var(--tx);color:#0e0d0c}
.c{background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.07);border-radius:20px;padding:5px}
.k{background:#0e0d0c;border-radius:15px;padding:16px 18px;box-shadow:inset 0 1px 1px rgba(255,255,255,.07);height:100%}
.k header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;gap:8px}.k h3{margin:0;font-weight:500;font-size:13px}.k header i{font-style:normal;color:var(--mu);font-size:12px}
.g{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px;margin-top:16px}.s3{grid-column:span 3}.s4{grid-column:span 4}.s5{grid-column:span 5}.s6{grid-column:span 6}.s7{grid-column:span 7}.s8{grid-column:span 8}.s12{grid-column:span 12}
.cv{position:relative;height:250px}.cv.t{height:340px}
.kp .l{color:var(--mu);font-size:12px}.kp .v{font-size:22px;font-weight:500;letter-spacing:-.02em;line-height:1.05;margin:8px 0 6px}.p1 .l{font-size:14px;color:var(--tx);font-weight:500}.p1 .v{font-size:clamp(60px,7.4vw,96px);font-weight:400;letter-spacing:-.045em;margin:18px 0 10px}.p1 .dl{font-size:13px}.p2 .l{font-size:13px;color:var(--tx);font-weight:500}.p2 .v{font-size:clamp(34px,3.6vw,48px);margin:14px 0 8px}.hs{margin-top:16px;padding-top:14px;border-top:1px solid rgba(255,255,255,.07);font-size:13px;color:var(--mu)}.hs b{color:var(--tx);font-weight:500}.lg{display:flex;justify-content:space-between;margin-top:8px;font-size:11px;color:var(--mu)}.st{display:grid;grid-template-columns:repeat(5,1fr);padding:10px 0}.sx{padding:2px 20px}.sx+.sx{border-left:1px solid rgba(255,255,255,.07)}.sx .dl{font-size:11px}.cap{margin:32px 0 0;font-size:12px;color:var(--mu)}.dl{font-size:12px;color:var(--mu)}.dl.g1{color:var(--ok)}.dl.b1{color:var(--bad)}
.bar3{display:flex;height:6px;border-radius:9px;overflow:hidden;margin-top:12px;gap:2px}
.fl{display:flex;flex-wrap:wrap;gap:10px;align-items:end}.fl label{display:flex;flex-direction:column;gap:4px;font-size:11px;color:var(--mu);flex:1 1 130px}
.fl select,.fl input,.fi{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:9px 12px;min-height:44px;font-size:14px}
.btn{padding:11px 20px;min-height:44px;border-radius:10px;background:var(--tx);color:#0e0d0c;font-weight:500}.btn.g2{background:rgba(255,255,255,.08);color:#fff}
#fb{display:none}
.hm{display:grid;grid-template-columns:104px repeat(24,1fr);gap:2px;min-width:600px}.hm b{font:500 10px Geist,sans-serif;color:var(--mu);align-self:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.hm i{height:15px;border-radius:4px;cursor:pointer}.hm u{font:10px Geist;color:var(--mu);text-decoration:none;text-align:center}.hm i.sel{outline:1px solid #fff}
.sc{overflow-x:auto}
.al{display:flex;gap:10px;padding:10px 12px;border-radius:14px;background:rgba(255,255,255,.03);cursor:pointer;margin-bottom:6px;transition:background .2s var(--eo)}.al .d{width:8px;height:8px;border-radius:50%;margin-top:6px;flex:none}.al small{color:var(--mu);display:block}
@media(hover:hover) and (pointer:fine){.al:hover{background:rgba(255,255,255,.07)}}
.ana{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.ti{padding:14px;border-radius:16px;background:rgba(255,255,255,.03)}.ti .l{font-size:12px;color:var(--mu)}.ti .v{font-size:20px;font-weight:500;margin:6px 0}.ti small{color:var(--mu);font-size:11px;display:block}
.tp{display:flex;align-items:center;gap:8px;padding:5px 0;cursor:pointer;font-size:12px}.tp em{flex:1;height:5px;border-radius:9px;background:rgba(255,255,255,.07);overflow:hidden;font-style:normal}.tp em i{display:block;height:100%;border-radius:9px}
.hw{display:flex;gap:14px;flex-wrap:wrap}.hc{position:relative;flex:1 1 480px;height:330px;border-radius:18px;background:radial-gradient(ellipse at 50% 100%,rgba(143,180,255,.1),transparent 70%),#080807;overflow:hidden;touch-action:pan-y}#hc{width:100%;height:100%;display:block}
.sim{position:absolute;left:12px;top:12px;font-size:10px;letter-spacing:.12em;padding:5px 10px;border-radius:99px;background:rgba(255,181,71,.12);color:var(--wa);max-width:calc(100% - 24px)}
.hp{flex:0 1 250px;min-width:220px;font-size:13px}.hp div{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.05)}.hp div span:first-child{color:var(--mu)}
.hl{outline:1px solid var(--ac);box-shadow:0 0 0 6px rgba(143,180,255,.12);transition:box-shadow .4s var(--eo)}
.rv{opacity:0;transform:translateY(12px);filter:blur(4px);transition:opacity .5s var(--ed),transform .5s var(--ed),filter .5s var(--ed);transition-delay:calc(var(--i,0)*50ms)}.rv.in{opacity:1;transform:none;filter:none}
/* AI */
#island{position:fixed;top:calc(var(--st) + 10px);left:50%;transform:translateX(-50%);width:128px;height:38px;border-radius:22px;background:#000;border:1px solid rgba(255,255,255,.1);z-index:60;touch-action:none;cursor:grab;transition:transform .35s var(--ed),width .35s var(--ed)}#island.dg{transition:none}#island.open{width:168px}
#av{position:fixed;left:0;top:0;width:36px;height:36px;border-radius:50%;background:#fff;z-index:70;pointer-events:none;transition:transform .5s var(--ed);box-shadow:0 0 24px rgba(255,255,255,.2)}
#av .e{position:absolute;top:13px;width:5px;height:7px;border-radius:50%;background:#111;animation:bl 4.5s infinite;transition:transform .3s var(--eo)}#av .e:nth-child(1){left:10px}#av .e:nth-child(2){right:10px}
#av .m{position:absolute;left:50%;top:24px;width:10px;height:3px;border-radius:9px;background:#111;transform:translateX(-50%) scaleY(var(--mo,1));transition:transform .1s}
#av[data-s=thinking] .e{transform:translateY(-3px)}#av[data-s=thinking]{animation:fl 1.2s cubic-bezier(.45,0,.55,1) infinite}#av[data-s=listening]{box-shadow:0 0 0 6px rgba(61,220,151,.3)}
@keyframes bl{0%,94%,100%{transform:scaleY(1)}97%{transform:scaleY(.1)}}@keyframes fl{50%{translate:0 -3px}}
#bub{position:fixed;z-index:65;max-width:240px;padding:10px 14px;border-radius:18px;background:rgba(240,240,248,.96);color:#0a0a10;font-size:13px;opacity:0;transform:scale(.92);pointer-events:none;transition:opacity .2s var(--eo),transform .2s var(--eo);transform-origin:top right}#bub.on{opacity:1;transform:none}
#pn{position:fixed;z-index:55;top:calc(var(--st) + 58px);left:50%;width:min(440px,calc(100vw - 20px));height:min(62dvh,520px);display:flex;flex-direction:column;border-radius:26px;background:rgba(18,18,26,.62);backdrop-filter:blur(26px);-webkit-backdrop-filter:blur(26px);border:1px solid rgba(255,255,255,.1);opacity:0;pointer-events:none;transform:translate(-50%,-14px) scale(.96);transform-origin:top center;transition:opacity .15s var(--eo),transform .2s var(--eo)}
#pn.on{opacity:1;pointer-events:auto;transform:translate(-50%,0);transition:opacity .25s var(--eo),transform .35s var(--ed)}
#pn header{display:flex;justify-content:space-between;align-items:center;padding:14px 16px 8px}#pn header b{font-weight:500}
#hist{flex:1;overflow:auto;padding:6px 16px;display:flex;flex-direction:column;gap:8px}.m1{max-width:85%;padding:9px 13px;border-radius:16px;background:rgba(255,255,255,.07);align-self:flex-start;white-space:pre-wrap}.m1.u{align-self:flex-end;background:var(--ac);color:#0e0d0c}.m1.n{font-size:12px;color:var(--mu);background:none;padding:0}
.ch{display:flex;gap:6px;flex-wrap:wrap;padding:0 16px 8px}.ch button{padding:11px 14px;border-radius:99px;background:rgba(255,255,255,.07);font-size:12px}
#pn form{display:flex;gap:8px;padding:10px 12px 14px}#pn form input{flex:1;font-size:16px;min-width:0}.ib{width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.08);flex:none;display:inline-grid;place-items:center}.ib svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.ib.on{background:var(--tx);color:#0e0d0c}
#set{display:none;padding:4px 16px 8px;font-size:12px;color:var(--mu)}#set.on{display:block}#set label{display:flex;gap:8px;align-items:center;padding:3px 0}#set input[type=text]{width:100%;font-size:16px;margin-top:4px}
@media(max-width:900px){main{padding:calc(var(--st) + 70px) 12px calc(100px + var(--sb)) 12px}.side{left:50%;top:auto;bottom:calc(10px + var(--sb));transform:translateX(-50%);flex-direction:row}
.g{gap:10px}.s3{grid-column:span 6}.s4,.s5,.s6,.s7,.s8{grid-column:span 12}.ana{grid-template-columns:1fr 1fr}#fb{display:inline-block}.fl{display:none}.fl.on{display:flex;margin-top:12px}.hc{height:260px;flex-basis:100%}.hp{flex-basis:100%}.kp.p1,.kp.p2{grid-column:span 12}.p2 .v{font-size:34px}.st{grid-template-columns:1fr 1fr;row-gap:12px}.sx+.sx{border-left:0}.sx{padding:2px 14px}.cv.t{height:300px}}
@media(max-width:520px){.ana{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition-duration:.01ms!important}.rv{opacity:1;transform:none;filter:none}}
</style></head><body>
<nav class="side" aria-label="Navigasi">
<a href="#kpis" title="Ringkasan"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1.5"/><rect x="14" y="4" width="6" height="6" rx="1.5"/><rect x="4" y="14" width="6" height="6" rx="1.5"/><rect x="14" y="14" width="6" height="6" rx="1.5"/></svg></a>
<a href="#c-line" title="Grafik"><svg viewBox="0 0 24 24"><path d="M4 18l5-6 4 3 7-9"/></svg></a>
<a href="#c-ana" title="Analisis"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4-4"/></svg></a>
<a href="#c-alerts" title="Peringatan"><svg viewBox="0 0 24 24"><path d="M6 17V11a6 6 0 0112 0v6l2 2H4zM10 21h4"/></svg></a>
<a href="#c-holo" title="Hologram"><svg viewBox="0 0 24 24"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5"/></svg></a></nav>
<div id="island" aria-label="Dynamic Island: tarik ke bawah untuk membuka asisten AI" role="button" tabindex="0"></div>
<div id="av" data-s="idle"><i class="e"></i><i class="e"></i><b class="m"></b></div><div id="bub"></div>
<aside id="pn" aria-label="Asisten AI"><header><b>Asisten UrbanFlow</b><span><button class="ib" id="gear" aria-label="Pengaturan"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/></svg></button> <button class="ib" id="cls" aria-label="Tutup panel"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></span></header>
<div id="set"><label><input type="checkbox" id="oa" checked> Avatar kembali ke Dynamic Island otomatis</label><label><input type="checkbox" id="ob" checked> Tampilkan bubble chat</label><label>Endpoint backend AI (opsional, mode demo bila kosong)<input class="fi" type="text" id="ep" placeholder="https://server-anda/api/ai"></label></div>
<div id="hist" role="log" aria-live="polite"></div><div class="ch"><button>Bawa saya ke ruas paling macet</button><button>Jam puncak kemacetan?</button><button>Prediksi 3 jam ke depan</button></div>
<form id="af"><input class="fi" id="aq" enterkeyhint="send" aria-label="Pertanyaan untuk asisten" placeholder="Tanya tentang lalu lintas…" autocomplete="off"><button type="button" class="ib" id="mic" aria-label="Input suara"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0014 0M12 18v3"/></svg></button><button type="button" class="ib" id="vo" aria-label="Suara AI" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6L8 10zM17 9l4 6M21 9l-4 6"/></svg></button><button type="button" class="ib" id="stp" aria-label="Hentikan suara"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2"/></svg></button><button class="ib" style="background:var(--tx);color:#0e0d0c" aria-label="Kirim"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg></button></form></aside>

<main>
<span class="eb" id="eb"></span>
<div class="top"><div><h1>Lalu lintas kota,<br><span id="hl">memuat…</span></h1><nav class="bc" id="bc"></nav></div>
<div class="seg" id="per"><button data-p="day" class="on">Hari Ini</button><button data-p="week">Minggu Ini</button><button data-p="month">Bulan Ini</button></div><button class="btn" id="cta">Tanya asisten</button></div>
<div class="c rv"><div class="k"><button class="btn g2" id="fb">Filter</button>
<div class="fl" id="fl"><label>Tanggal<input type="date" id="fd"></label><label>Kecamatan<select id="fk"></select></label><label>Ruas jalan<select id="fr"></select></label><label>Kendaraan<select id="fv"><option value="">Semua</option><option value="0">Motor</option><option value="1">Mobil</option><option value="2">Bus</option><option value="3">Truk</option></select></label><label>Dari jam<select id="f1"></select></label><label>Sampai jam<select id="f2"></select></label><button class="btn" id="rs">Atur ulang</button></div></div></div>
<div class="g" id="kpis"></div>
<div class="g">
<section class="c s8 rv" id="c-line"><div class="k"><header><h3>Kepadatan per jam</h3><i>garis putus: prediksi · klik untuk pilih jam</i></header><div class="cv" style="height:300px"><canvas id="ln"></canvas></div></div></section>
<section class="c s4 rv" id="c-donut"><div class="k"><header><h3>Kondisi jalan</h3><i>klik untuk penjelasan</i></header><div class="cv"><canvas id="dn"></canvas></div></div></section>
<section class="c s7 rv" id="c-bar"><div class="k"><header><h3>Volume kendaraan per ruas</h3><i>klik batang untuk drill-down</i></header><div class="cv t"><canvas id="br"></canvas></div></div></section>
<section class="c s5 rv" id="c-stk"><div class="k"><header><h3>Komposisi jenis kendaraan</h3><i>ribu kendaraan</i></header><div class="cv t"><canvas id="sk"></canvas></div></div></section>
<section class="c s8 rv" id="c-heat"><div class="k"><header><h3>Heatmap kemacetan</h3><i>ruas × jam · klik sel</i></header><div class="sc"><div class="hm" id="hm"></div></div></div></section>
<section class="c s4 rv" id="c-sct"><div class="k"><header><h3>Volume vs kecepatan</h3><i>tiap titik = ruas × jam</i></header><div class="cv t"><canvas id="sc"></canvas></div></div></section>
<section class="c s7 rv" id="c-area"><div class="k"><header><h3>Pagi · Siang · Sore</h3><i>klik area untuk memilih jam</i></header><div class="cv"><canvas id="ar"></canvas></div></div></section>
<section class="c s5 rv" id="c-alerts"><div class="k"><header><h3>Peringatan <span id="ac"></span></h3><i>ambang <b id="tv">70</b>% <input type="range" id="th" aria-label="Ambang kepadatan" min="40" max="90" value="70" style="width:70px;vertical-align:middle"></i></header><div id="al"></div></div></section>
<section class="c s12 rv" id="c-ana"><div class="k"><header><h3>Analisis & rekomendasi</h3><i>seluruhnya dihitung dari data aktif</i></header><div class="ana" id="ana"></div></div></section>
<section class="c s12 rv" id="c-holo"><div class="k"><header><h3>Hologram ruas jalan</h3><span><select class="fi" id="hr" aria-label="Ruas jalan hologram"></select> <button class="ib" id="zo" aria-label="Perkecil">−</button> <button class="ib" id="zi" aria-label="Perbesar">+</button></span></header>
<div class="hw"><div class="hc"><canvas id="hc" role="img" aria-label="Simulasi hologram kendaraan pada ruas terpilih"></canvas><span class="sim">SIMULASI VISUAL — BUKAN KONDISI LALU LINTAS REAL-TIME</span></div><div class="hp" id="hp"><small style="color:var(--mu)">Ketuk kendaraan pada hologram untuk melihat detail simulasi.</small></div></div></div></section>
</div><p class="cap" id="cap">Memuat data dari server…</p></main>

<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)],cl=(v,a,b)=>Math.max(a,Math.min(b,v)),wait=ms=>new Promise(r=>setTimeout(r,ms)),f=n=>Math.round(n).toLocaleString('id-ID'),pad=h=>String(h).padStart(2,'0')+'.00';
const rng=s=>()=>(s=(s*1664525+1013904223)>>>0)/4294967296,g=(h,m,s)=>Math.exp(-(((h-m)/s)**2));
let KEC=[],ROADS=[];
const kn=id=>KEC.find(k=>k[0]===id)?.[1]||'',mix=r=>r.mix,VT=['Motor','Mobil','Bus','Truk'],ST=['Lancar','Padat','Macet'],SC=['#3ddc97','#ffb547','#ff5c5c'],st=d=>d<50?0:d<75?1:2;
let BASE=0,NDAYS=0;const dt=i=>new Date(BASE+i*864e5),isWe=i=>[0,6].includes(dt(i).getUTCDay()),dl=i=>dt(i).toLocaleDateString('id-ID',{day:'numeric',month:'short',timeZone:'UTC'});
let D=[];
const S={date:0,kec:'',road:'',veh:'',h1:0,h2:23,per:'day',thr:70};
const span=(sh=0)=>{const n={day:1,week:7,month:28}[S.per],d1=S.date-sh*n,d0=Math.max(0,d1-n+1);return[d0,d1]};
function Q(sh=0,allH=false,sr=true){const[d0,d1]=span(sh),o=[];ROADS.forEach((r,ri)=>{if(S.kec&&r.k!==S.kec||sr&&S.road&&r.id!==S.road)return;const m=S.veh===''?1:mix(r)[+S.veh];for(let d=d0;d<=d1;d++)for(let h=allH?0:S.h1;h<=(allH?23:S.h2);h++){const x=D[ri][d][h];if(!x)continue;o.push({r,ri,d,h,v:x.v*m,v0:x.v,dn:x.dn,s:x.s,a:x.a*m})}});return o}
function K(r){if(!r.length)return{tot:0,dn:0,sp:0,ac:0,tt:0,dl:0,co:0,c:[0,0,0]};let t=0,dn=0,sv=0,a=0,tt=0,dd=0,co=0,c=[0,0,0];r.forEach(x=>{t+=x.v;dn+=x.dn;sv+=x.s*x.v;a+=x.a;const ta=600/x.s,ft=600/x.r.f;tt+=ta*x.v;dd+=(ta-ft)*x.v;co+=x.v*2*.17*(1+x.dn/100)/1000;c[st(x.dn)]++});return{tot:t,dn:dn/r.length,sp:t?sv/t:0,ac:a,tt:t?tt/t:0,dl:t?dd/t:0,co,c:c.map(v=>v/r.length*100)}}
const avg=(a,fn)=>a.length?a.reduce((q,x)=>q+fn(x),0)/a.length:0;
function grp(rows,key){const m=new Map();rows.forEach(x=>{const k=key(x);let o=m.get(k);if(!o)m.set(k,o={k,n:0,dn:0,s:0,v:0,a:0,r:x.r});o.n++;o.dn+=x.dn;o.s+=x.s;o.v+=x.v;o.a+=x.a});return[...m.values()].map(o=>({...o,dn:o.dn/o.n,s:o.s/o.n}))}
const dm=(d,h)=>avg(ROADS.map((r,i)=>[r,i]).filter(([r])=>(!S.kec||r.k===S.kec)&&(!S.road||r.id===S.road)),([r,i])=>D[i][d][h].dn);
function predict(){const o=[];for(let k=1;k<=3&&S.h2+k<=23;k++){const h=S.h2+k,P=[1,2,3].map(j=>S.date-7*j).filter(d=>d>=0);let hist=P.length?avg(P,d=>dm(d,h)):dm(S.date,h);const adj=P.length?(dm(S.date,S.h2)-avg(P,d=>dm(d,S.h2)))*(1-k*.25):0;o.push({h,v:cl(hist+adj,0,100)})}return o}
// ---------- charts
Chart.defaults.color='#8a8a98';Chart.defaults.font.family='Geist,system-ui';Chart.defaults.borderColor='rgba(255,255,255,.06)';Chart.defaults.animation.duration=250;const SPK0='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6L8 10zM17 9l4 6M21 9l-4 6"/></svg>',SPK1='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6L8 10zM16 9a4 4 0 010 6"/></svg>';Chart.defaults.plugins.legend.display=false;Object.assign(Chart.defaults.plugins.tooltip,{backgroundColor:'#16161f',borderColor:'rgba(255,255,255,.1)',borderWidth:1,padding:10});
const CH={},O=(x={})=>({responsive:true,maintainAspectRatio:false,...x});
const hit=(c,ev,cb)=>{const e=c.getElementsAtEventForMode(ev,'nearest',{intersect:true},true)[0];if(e)cb(e)};
const lab=Array.from({length:24},(_,i)=>pad(i).slice(0,2));
const sel=(o)=>{Object.assign(S,o);render()};
CH.ln=new Chart($('#ln'),{type:'line',data:{labels:lab,datasets:[]},options:O({interaction:{mode:'index',intersect:false},scales:{y:{min:0,max:100,ticks:{callback:v=>v+'%'}},x:{grid:{display:false}}},onClick:(ev,_,c)=>{const e=c.getElementsAtEventForMode(ev,'index',{intersect:false},true)[0];if(e)sel({h1:e.index,h2:e.index})}})});
CH.dn=new Chart($('#dn'),{type:'doughnut',data:{labels:ST,datasets:[{data:[],backgroundColor:SC,borderWidth:0,spacing:3,borderRadius:6}]},options:O({cutout:'72%',plugins:{legend:{display:true,position:'bottom',labels:{usePointStyle:true,boxWidth:8}}},onClick:(ev,_,c)=>hit(c,ev,e=>explainCond(e.index))})});
CH.br=new Chart($('#br'),{type:'bar',data:{labels:[],datasets:[{data:[],borderRadius:6,maxBarThickness:16}]},options:O({indexAxis:'y',scales:{x:{ticks:{callback:v=>v/1000+'k'}},y:{grid:{display:false},ticks:{font:{size:10}}}},onClick:(ev,_,c)=>hit(c,ev,e=>{const r=CH.br._r[e.index];sel({kec:r.k,road:r.id})})})});
CH.sk=new Chart($('#sk'),{type:'bar',data:{labels:[],datasets:[]},options:O({plugins:{legend:{display:true,labels:{usePointStyle:true,boxWidth:8}}},scales:{x:{stacked:true,grid:{display:false},ticks:{font:{size:10}}},y:{stacked:true}},onClick:(ev,_,c)=>hit(c,ev,e=>{const k=CH.sk._k[e.index];S.kec?sel({road:k}):sel({kec:k,road:''})})})});
CH.sc=new Chart($('#sc'),{type:'scatter',data:{datasets:[{data:[],pointRadius:3.5,pointHoverRadius:6}]},options:O({scales:{x:{title:{display:true,text:'Volume (kend/jam)'}},y:{title:{display:true,text:'Kecepatan (km/jam)'},min:0}},plugins:{tooltip:{callbacks:{label:c=>{const p=c.raw;return`${p.n} · ${pad(p.h)} · ${f(p.x)} kend/jam · ${p.y.toFixed(0)} km/j`}}}},onClick:(ev,_,c)=>hit(c,ev,e=>{const p=c.data.datasets[0].data[e.index];sel({kec:p.k,road:p.id,h1:p.h,h2:p.h})})})});
CH.ar=new Chart($('#ar'),{type:'line',data:{labels:lab,datasets:[]},options:O({plugins:{legend:{display:true,labels:{usePointStyle:true,boxWidth:8}}},scales:{x:{grid:{display:false}},y:{ticks:{callback:v=>v/1000+'k'}}},onClick:(ev,_,c)=>hit(c,ev,e=>{const w=[[5,10],[11,15],[16,21]][e.datasetIndex];sel({h1:w[0],h2:w[1]})})})});
function up(id,labels,ds){const c=CH[id];if(labels)c.data.labels=labels;ds.forEach((d,i)=>c.data.datasets[i]?Object.assign(c.data.datasets[i],d):c.data.datasets[i]=d);c.data.datasets.length=ds.length;c.update()}
// ---------- KPI
const KD=[['tot','Kendaraan melintas',v=>f(v),0,'Total kendaraan pada filter aktif'],['dn','Kepadatan',v=>v.toFixed(0)+'%',-1,'Rata-rata volume terhadap kapasitas ruas'],['sp','Kecepatan rata-rata',v=>v.toFixed(0)+' km/j',1,'Rata-rata tertimbang volume'],['ac','Kecelakaan',v=>f(v),-1,'Estimasi kejadian pada filter aktif'],['tt','Waktu tempuh',v=>v.toFixed(0)+' mnt',-1,'Per 10 km, tertimbang volume'],['c','Kondisi jalan',null,-1,'Lancar / padat / macet (% pengamatan)'],['dl','Keterlambatan',v=>v.toFixed(0)+' mnt',-1,'Tambahan waktu per 10 km dibanding arus bebas'],['co','Emisi CO₂',v=>v.toFixed(1)+' ton',-1,'Estimasi: 0,17 kg/kend-km × (1 + kepadatan), segmen 2 km']];
const KL={dn:['p1','s5'],tot:['p2','s4'],c:['p2','s3']},kc=d=>`<div class="l">${d[1]}</div><div class="v" id="kv-${d[0]}">–</div><div class="dl" id="kd-${d[0]}"></div>`;
$('#kpis').innerHTML=['dn','tot','c'].map(i=>{const d=KD.find(x=>x[0]===i);return`<div class="c ${KL[i][1]} rv kp ${KL[i][0]}" title="${d[4]}"><div class="k">${kc(d)}${i=='dn'?'<div class="hs" id="hs"></div>':''}${i=='c'?'<div class="bar3"><i style="background:var(--ok)"></i><i style="background:var(--wa)"></i><i style="background:var(--bad)"></i></div><div class="lg"><span>Lancar</span><span>Padat</span><span>Macet</span></div>':''}</div></div>`}).join('')+`<div class="c s12 rv kp"><div class="k st">${KD.filter(d=>!KL[d[0]]).map(d=>`<div class="sx" title="${d[4]}">${kc(d)}</div>`).join('')}</div></div>`;
function kpis(k,p){KD.forEach(([id,,fm,dir])=>{const v=$('#kv-'+id),d=$('#kd-'+id);let ch;if(id=='c'){v.textContent=k.c.map(x=>x.toFixed(0)).join(' / ')+'%';$$('.bar3 i').forEach((e,i)=>e.style.flex=k.c[i]+.01);ch=k.c[2]-p.c[2];d.textContent=(ch>=0?'▲ ':'▼ ')+Math.abs(ch).toFixed(1)+' poin macet';}else{v.textContent=fm(k[id]);ch=p[id]?(k[id]-p[id])/p[id]*100:0;d.textContent=(ch>=0?'▲ ':'▼ ')+Math.abs(ch).toFixed(1)+'% vs periode lalu'}d.className='dl '+(dir&&Math.abs(ch)>.5?(ch*dir>0?'g1':'b1'):'')})}
// ---------- render
function sync(){const[Y0,Y1]=span(),FO={day:'numeric',month:'short',year:'numeric',timeZone:'UTC'},FL=dt(Y0).toLocaleDateString('en-GB',FO);$('#eb').textContent=S.per==='day'?'Traffic Overview · '+dt(Y1).toLocaleDateString('en-GB',{weekday:'short',...FO}):(S.per==='week'?'Traffic Performance · ':'City Traffic Analytics · ')+(Y0===Y1?FL:dt(Y0).toLocaleDateString('en-GB',{day:'numeric',timeZone:'UTC'})+' – '+dt(Y1).toLocaleDateString('en-GB',FO));$('#fd').value=dt(S.date).toISOString().slice(0,10);$('#fk').value=S.kec;const rs=ROADS.filter(r=>!S.kec||r.k===S.kec),o='<option value="">Semua ruas</option>'+rs.map(r=>`<option value="${r.id}">${r.n}</option>`).join('');$('#fr').innerHTML=o;$('#hr').innerHTML=o;$('#fr').value=$('#hr').value=S.road;$('#f1').value=S.h1;$('#f2').value=S.h2;$('#fv').value=S.veh;$$('#per button').forEach(b=>b.classList.toggle('on',b.dataset.p===S.per));
 const r=ROADS.find(x=>x.id===S.road),bc=[['Kota',()=>sel({kec:'',road:'',h1:0,h2:23})]];if(S.kec)bc.push([kn(S.kec),()=>sel({road:'',h1:0,h2:23})]);if(r)bc.push([r.n,()=>sel({h1:0,h2:23})]);if(S.h1===S.h2)bc.push([pad(S.h1),()=>{}]);else if(S.h1||S.h2<23)bc.push([pad(S.h1)+'–'+pad(S.h2),()=>{}]);
 $('#bc').innerHTML='';bc.forEach((b,i)=>{if(i)$('#bc').append(' › ');const e=document.createElement('button');e.textContent=b[0];e.onclick=b[1];$('#bc').append(e)})}
function render(){S.h2=Math.max(S.h1,S.h2);sync();const rows=Q(),k=K(rows),p=K(Q(1));kpis(k,p);
 $('#hl').innerHTML=`<i style="display:inline-block;width:.4em;height:.4em;border-radius:50%;background:${SC[st(k.dn)]};vertical-align:middle;margin-right:.2em"></i>${ST[st(k.dn)]} · ${k.dn.toFixed(0)}% padat`;
 const w0=worst()[0];$('#hs').innerHTML=w0?`Ruas terpadat <b>${w0.r.n}</b>, ${kn(w0.r.k)} · ${w0.dn.toFixed(0)}%`:'';$('#kv-dn').style.color=SC[st(k.dn)];const all=Q(0,true),byH=grp(all,x=>x.h).sort((a,b)=>a.k-b.k),pr=predict(),dv=byH.map(x=>x.dn),inr=i=>i>=S.h1&&i<=S.h2;
 const pd=Array(24).fill(null);if(pr.length){pd[S.h2]=dv[S.h2];pr.forEach(x=>pd[x.h]=x.v)}
 up('ln',null,[{label:'Kepadatan',data:dv,borderColor:'#8fb4ff',backgroundColor:'rgba(143,180,255,.1)',fill:true,tension:.4,pointRadius:c=>inr(c.dataIndex)?3:0,pointBackgroundColor:'#fff',borderWidth:2},{label:'Prediksi',data:pd,borderColor:'#d9d7cf',borderDash:[5,4],tension:.4,pointRadius:3,borderWidth:2}]);
 const cc=K(all).c;up('dn',null,[{data:cc.map(v=>+v.toFixed(1))}]);
 const roadsAll=grp(Q(0,false,false),x=>x.r.id).sort((a,b)=>b.v-a.v);CH.br._r=roadsAll.map(x=>x.r);up('br',roadsAll.map(x=>x.r.n.replace('Jl. ','')),[{data:roadsAll.map(x=>x.v),backgroundColor:roadsAll.map(x=>SC[st(x.dn)]+(S.road&&x.r.id!==S.road?'55':''))}]);
 const sg=grp(Q(0,false,false).map(x=>({...x,kk:S.kec?x.r.id:x.r.k})),x=>x.kk),sd=sg.map(x=>({r:x.r,k:x.k}));CH.sk._k=sg.map(x=>x.k);
 const tv=sg.map(x=>{const rr=Q(0,false,false).filter(y=>(S.kec?y.r.id:y.r.k)===x.k);return VT.map((_,i)=>rr.reduce((q,y)=>q+y.v0*mix(y.r)[i]*(S.veh===''||+S.veh===i?1:0),0))});
 up('sk',sg.map(x=>S.kec?x.r.n.replace('Jl. ',''):kn(x.k)),VT.map((n,i)=>({label:n,data:tv.map(t=>t[i]),backgroundColor:['#8fb4ff','#d9d7cf','#9a998f','#5b5a54'][i],borderRadius:3})));
 const pts=grp(Q(0,true,false),x=>x.ri*24+x.h).map(x=>({x:x.v/x.n*1,y:x.s,n:x.r.n,h:x.k%24,id:x.r.id,k:x.r.k,dn:x.dn}));up('sc',null,[{data:pts,backgroundColor:pts.map(p=>SC[st(p.dn)]+'aa')}]);
 const wv=Array.from({length:24},(_,h)=>{const a=all.filter(x=>x.h===h);return a.length?a.reduce((q,x)=>q+x.v,0)/new Set(a.map(x=>x.d)).size:0}),W=[[5,10,'Pagi','#d9d7cf'],[11,15,'Siang','#8fb4ff'],[16,21,'Sore','#9a998f']];
 up('ar',null,W.map(w=>({label:w[2],data:wv.map((v,h)=>h>=w[0]&&h<=w[1]?v:null),borderColor:w[3],backgroundColor:w[3]+'33',fill:true,tension:.4,pointRadius:0,borderWidth:2})));
 heat();alerts();ana();holoBuild()}
function heat(){const rs=ROADS.map((r,i)=>[r,i]).filter(([r])=>!S.kec||r.k===S.kec),[d0,d1]=span(),n=d1-d0+1;let h='<span></span>'+lab.map((l,i)=>`<u>${i%3?'':l}</u>`).join('');rs.forEach(([r,ri])=>{h+=`<b title="${r.n}">${r.n.replace('Jl. ','')}</b>`;for(let x=0;x<24;x++){let s=0;for(let d=d0;d<=d1;d++)s+=D[ri][d][x].dn;s/=n;const hu=s<60?150-s/60*112:38-(s-60)/40*38;h+=`<i data-r="${r.id}" data-h="${x}" title="${r.n} · ${pad(x)} · ${s.toFixed(0)}%" class="${r.id===S.road&&x>=S.h1&&x<=S.h2?'sel':''}" style="background:hsl(${hu} 70% 45%/${.25+s/130})"></i>`}});$('#hm').innerHTML=h}
$('#hm').onclick=e=>{const i=e.target.closest('i');if(i){const r=ROADS.find(x=>x.id===i.dataset.r);sel({kec:r.k,road:r.id,h1:+i.dataset.h,h2:+i.dataset.h})}};
function alerts(){const[,d]=span(),L=[];ROADS.forEach((r,ri)=>{if(S.kec&&r.k!==S.kec||S.road&&r.id!==S.road)return;for(let h=S.h1;h<=S.h2;h++){const x=D[ri][d][h];if(x.dn>=S.thr-12)L.push({r,h,...x})}});L.sort((a,b)=>b.dn-a.dn);const lv=x=>x.dn>=S.thr+15?2:x>=0&&x.dn>=S.thr?1:0,N=['Informasi','Peringatan','Kritis'],C=['#8fb4ff','#ffb547','#ff5c5c'];
 $('#ac').textContent='· '+L.filter(x=>x.dn>=S.thr).length+' aktif';$('#al').innerHTML=L.slice(0,6).map((x,i)=>`<div class="al" data-i="${i}"><span class="d" style="background:${C[lv(x)]}"></span><div><b>${N[lv(x)]} · ${x.r.n}</b><small>${kn(x.r.k)} · ${dl(d)} ${pad(x.h)} · kepadatan ${x.dn.toFixed(0)}%</small><small>Pemicu: kecepatan ${x.s.toFixed(0)} km/j (${((1-x.s/x.r.f)*100).toFixed(0)}% di bawah arus bebas), volume ${f(x.v)} kend/jam${x.a?', ada kecelakaan':''}</small></div></div>`).join('')||'<small style="color:var(--mu)">Tidak ada kondisi di atas ambang pada filter ini.</small>';A_L=L.slice(0,6)}
let A_L=[];$('#al').onclick=e=>{const a=e.target.closest('.al');if(a){const x=A_L[+a.dataset.i];sel({kec:x.r.k,road:x.r.id,h1:x.h,h2:x.h});hl('line')}};
$('#th').oninput=e=>{S.thr=+e.target.value;$('#tv').textContent=S.thr;alerts()};
function rs(allH=false){const m={};Q(0,allH,false).forEach(x=>{const o=m[x.r.id]??={r:x.r,n:0,dn:0,s:0,v:0,a:0};o.n++;o.dn+=x.dn;o.s+=x.s;o.v+=x.v;o.a+=x.a});return m}
const worst=()=>Object.values(rs()).map(o=>({...o,dn:o.dn/o.n,s:o.s/o.n})).sort((a,b)=>b.dn-a.dn);
function peakH(){const a=grp(Q(0,true,false),x=>x.h).sort((a,b)=>b.dn-a.dn)[0];return a||{k:0,dn:0}}
function ana(){const w=worst(),pk=peakH(),pr=predict();let wd=[],we=[];for(let d=0;d<=S.date;d++)(isWe(d)?we:wd).push(avg(ROADS.map((r,i)=>[r,i]).filter(([r])=>(!S.kec||r.k===S.kec)&&(!S.road||r.id===S.road)),([r,i])=>avg(Array.from({length:S.h2-S.h1+1},(_,j)=>D[i][d][S.h1+j]),x=>x.dn)));
 const a=avg(wd,x=>x),b=avg(we,x=>x),top=w.slice(0,5);
 $('#ana').innerHTML=`<div class="ti"><div class="l">Jam puncak</div><div class="v">${pad(pk.k)}</div><small>Kepadatan rata-rata ${pk.dn.toFixed(0)}%. Dasar: rata-rata per jam seluruh ruas pada periode aktif.</small></div>
<div class="ti"><div class="l">Ruas terparah</div><div class="v" style="font-size:16px">${w[0]?w[0].r.n:'–'}</div><small>${w[0]?w[0].dn.toFixed(0)+'% · '+w[0].s.toFixed(0)+' km/j · '+kn(w[0].r.k):''}. Dasar: rata-rata kepadatan tertinggi.</small></div>
<div class="ti"><div class="l">Hari kerja vs akhir pekan</div><div class="v">${a.toFixed(0)}% / ${b.toFixed(0)}%</div><small>Selisih ${(a-b).toFixed(0)} poin. Dasar: rata-rata ${wd.length} hari kerja dan ${we.length} akhir pekan s.d. ${dl(S.date)}.</small></div>
<div class="ti"><div class="l">Prediksi</div><div class="v" style="font-size:15px">${pr.map(x=>pad(x.h).slice(0,2)+': '+x.v.toFixed(0)+'%').join(' · ')||'Di luar jam prediksi'}</div><small>Dasar: rata-rata hari yang sama 3 minggu terakhir + selisih tren hari ini.</small></div>
<div class="ti" style="grid-column:1/-1"><div class="l">5 lokasi paling padat</div>${top.map(x=>`<div class="tp" data-r="${x.r.id}"><span style="width:150px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${x.r.n}</span><em><i style="width:${x.dn}%;background:${SC[st(x.dn)]}"></i></em><b>${x.dn.toFixed(0)}%</b></div>`).join('')}</div>`}
$('#ana').onclick=e=>{const t=e.target.closest('.tp');if(t){const r=ROADS.find(x=>x.id===t.dataset.r);sel({kec:r.k,road:r.id})}};
// ---------- filters
function initFilters(){$('#fk').innerHTML='<option value="">Semua kecamatan</option>';KEC.forEach(k=>$('#fk').add(new Option(k[1],k[0])))}
for(let i=0;i<24;i++){$('#f1').add(new Option(pad(i),i));$('#f2').add(new Option(pad(i),i))}
$('#fk').onchange=e=>sel({kec:e.target.value,road:''});$('#fr').onchange=$('#hr').onchange=e=>{const r=ROADS.find(x=>x.id===e.target.value);sel({road:e.target.value,kec:r?r.k:S.kec})};
$('#fv').onchange=e=>sel({veh:e.target.value});$('#f1').onchange=e=>sel({h1:+e.target.value});$('#f2').onchange=e=>sel({h2:+e.target.value});
$('#fd').onchange=e=>{const d=Math.round((Date.parse(e.target.value)-BASE)/864e5);sel({date:cl(isNaN(d)?NDAYS-1:d,0,NDAYS-1)})};
$('#per').onclick=e=>{if(e.target.dataset.p)sel({per:e.target.dataset.p})};$('#rs').onclick=reset;$('#fb').onclick=()=>$('#fl').classList.toggle('on');
function reset(){Object.assign(S,{date:NDAYS-1,kec:'',road:'',veh:'',h1:0,h2:23,per:'day'});render()}
// ---------- hologram (kanvas 2D, proyeksi oblik; data simulasi)
const H={cars:[],z:1,sel:null,vis:true,rid:null,dn:0,s:0};
function holoBuild(){const w=worst(),r=S.road?ROADS.find(x=>x.id===S.road):w[0]?.r;if(!r)return;const ri=ROADS.indexOf(r),[d0,d1]=span();let dn=0,s=0,n=0;for(let d=d0;d<=d1;d++)for(let h=S.h1;h<=S.h2;h++){dn+=D[ri][d][h].dn;s+=D[ri][d][h].s;n++}dn/=n;s/=n;H.r=r;H.dn=dn;H.s=s;const R=rng(ri*31+7),N=Math.round(6+dn/100*22),m=mix(r),keep=H.sel?.id;H.cars=[];const cnt=[0,0,0,0];for(let i=0;i<N;i++)cnt[i%4]++;let id=0;for(let ln=0;ln<4;ln++)for(let j=0;j<cnt[ln];j++){const u=R();let t=u<m[0]?0:u<m[0]+m[1]?1:u<m[0]+m[1]+m[2]?2:3;if(i_t(t,R)){}H.cars.push({ln,x:(j+R()*.6)*100/cnt[ln],t,v:Math.max(0,s*(.8+R()*.4)),id:'SIM-'+String(ri*100+id++).padStart(4,'0'),pl:'SIM '+(1000+(ri*371+id*53)%9000)+' '+String.fromCharCode(65+(id*7)%26)+String.fromCharCode(65+(id*11)%26)})}H.sel=H.cars.find(c=>c.id===keep)||null;showCar()}
const i_t=()=>0,DIM=[[2.2,1,1.2],[4.2,1.9,1.5],[9,2.4,2.6],[7.5,2.3,2.4]],LY=[2.5,7.5,12.5,17.5],RGB=['61,220,151','255,181,71','255,92,92'];
function showCar(){const c=H.sel;$('#hp').innerHTML=c?`<b style="font-size:15px">${H.r.n}</b><div><span>ID</span><span>${c.id}</span></div><div><span>Jenis</span><span>${VT[c.t]}</span></div><div><span>Kecepatan</span><span>${c.v.toFixed(0)} km/j</span></div><div><span>Arah</span><span>${c.ln<2?'Timur →':'← Barat'}</span></div><div><span>Waktu</span><span>${dl(S.date)} ${pad(S.h2)}</span></div><div><span>Status</span><span>${c.v<5?'Berhenti':c.v<20?'Merayap':'Lancar'}</span></div><div><span>Plat simulasi</span><span>${c.pl}</span></div><small style="color:var(--mu);display:block;margin-top:8px">Data fiktif; bukan identitas kendaraan nyata.</small>`:`<b style="font-size:15px">${H.r?.n||''}</b><div><span>Kendaraan simulasi</span><span>${H.cars.length}</span></div><div><span>Kepadatan</span><span style="color:${SC[st(H.dn)]}">${H.dn.toFixed(0)}% · ${ST[st(H.dn)]}</span></div><div><span>Kecepatan</span><span>${H.s.toFixed(0)} km/j</span></div><small style="color:var(--mu);display:block;margin-top:8px">Ketuk kendaraan pada hologram untuk detail.</small>`}
const hc=$('#hc'),hx=hc.getContext('2d'),RM=matchMedia('(prefers-reduced-motion:reduce)').matches;let last=0,dim={w:0,h:0};
new IntersectionObserver(e=>H.vis=e[0].isIntersecting).observe(hc);
function frame(t){requestAnimationFrame(frame);if(!H.vis||document.hidden||!H.r)return;const dp=Math.min(devicePixelRatio||1,2),W=hc.clientWidth,Hh=hc.clientHeight;if(hc.width!==Math.round(W*dp)){hc.width=W*dp;hc.height=Hh*dp}const dtm=Math.min(.05,(t-last)/1000||0);last=t;const x=hx;x.setTransform(dp,0,0,dp,0,0);x.clearRect(0,0,W,Hh);
 const sc=W/122*H.z,P=(a,b,z=0)=>[W/2+(a-50)*sc+(b-10)*sc*.35,Hh*.55+(b-10)*sc*.8-z*sc],col=RGB[st(H.dn)];
 x.strokeStyle='rgba(143,180,255,.14)';x.lineWidth=1;for(let a=0;a<=100;a+=10){x.beginPath();x.moveTo(...P(a,-8));x.lineTo(...P(a,28));x.stroke()}for(let b=-8;b<=28;b+=6){x.beginPath();x.moveTo(...P(0,b));x.lineTo(...P(100,b));x.stroke()}
 x.beginPath();[[0,0],[100,0],[100,20],[0,20]].forEach(([a,b],i)=>x[i?'lineTo':'moveTo'](...P(a,b)));x.closePath();x.fillStyle='rgba(255,255,255,.05)';x.fill();x.strokeStyle=`rgba(${col},.8)`;x.stroke();
 x.setLineDash([6,6]);x.strokeStyle='rgba(255,255,255,.25)';[5,15].forEach(b=>{x.beginPath();x.moveTo(...P(0,b));x.lineTo(...P(100,b));x.stroke()});x.setLineDash([]);x.strokeStyle='rgba(255,255,255,.5)';x.beginPath();x.moveTo(...P(0,10));x.lineTo(...P(100,10));x.stroke();
 for(let a=12;a<100;a+=28)LY.forEach((b,i)=>{const d=i<2?1:-1;x.beginPath();x.moveTo(...P(a-1.6*d,b-1.1));x.lineTo(...P(a+1.6*d,b));x.lineTo(...P(a-1.6*d,b+1.1));x.strokeStyle=`rgba(${col},.5)`;x.stroke()});
 const sw=(t/40)%130-15;x.fillStyle='rgba(143,180,255,.06)';x.fillRect(W/2+(sw-50)*sc,0,3*sc,Hh);
 H.cars.forEach(c=>{if(!RM&&dtm){c.x+=(c.ln<2?1:-1)*c.v*.25*dtm;if(c.x>105)c.x=-10;if(c.x<-10)c.x=105}});
 [...H.cars].sort((a,b)=>(a.ln-b.ln)||(a.x-b.x)).forEach(c=>{const[l,w,h]=DIM[c.t],y=LY[c.ln]-w/2,a=c.x,fc=(o)=>{x.beginPath();o.forEach((p,i)=>x[i?'lineTo':'moveTo'](...P(...p)));x.closePath()};const on=H.sel===c;x.lineWidth=on?2:1;x.strokeStyle=on?'#fff':`rgba(${col},.9)`;x.shadowColor=on?'#fff':'transparent';x.shadowBlur=on?14:0;
  fc([[a,y+w,0],[a+l,y+w,0],[a+l,y+w,h],[a,y+w,h]]);x.fillStyle=`rgba(${col},.14)`;x.fill();x.stroke();fc([[a+l,y,0],[a+l,y+w,0],[a+l,y+w,h],[a+l,y,h]]);x.fillStyle=`rgba(${col},.08)`;x.fill();x.stroke();fc([[a,y,h],[a+l,y,h],[a+l,y+w,h],[a,y+w,h]]);x.fillStyle=`rgba(${col},.3)`;x.fill();x.stroke();x.shadowBlur=0;const q=P(a+l/2,y+w/2,h);c.sx=q[0];c.sy=q[1]})}
requestAnimationFrame(frame);
hc.addEventListener('pointerdown',e=>{const r=hc.getBoundingClientRect(),px=e.clientX-r.left,py=e.clientY-r.top;let b=null,bd=26;H.cars.forEach(c=>{const d=Math.hypot(c.sx-px,c.sy-py);if(d<bd){bd=d;b=c}});H.sel=b;showCar()});
$('#zi').onclick=()=>H.z=Math.min(1.8,H.z+.2);$('#zo').onclick=()=>H.z=Math.max(.7,H.z-.2);
// ---------- AI: avatar, Dynamic Island, bubble, aksi terstruktur
const av=$('#av'),isl=$('#island'),bub=$('#bub'),pn=$('#pn'),A={open:false,busy:false,x:0,y:0,s:.58,voice:false,q:0,request:0,ep:'',idle:0,hov:false,hist:[]};
const anchor=()=>{const r=isl.getBoundingClientRect();return[r.left+r.width/2,r.top+r.height/2,.58]};
function moveTo(x,y,s=1){x=cl(x,22,innerWidth-22);y=cl(y,22,innerHeight-22);A.x=x;A.y=y;A.s=s;av.style.transform=`translate3d(${x-18}px,${y-18}px,0) scale(${s})`;placeBub()}
const home=()=>{moveTo(...anchor());setSt('idle')};
function moveAvatar(position){if(position==='home'){home();return}const x=position.endsWith('left')?56:position.endsWith('right')?innerWidth-56:innerWidth/2,y=position.startsWith('top')?72:position.startsWith('bottom')?innerHeight-72:innerHeight/2;moveTo(x,y,1)}
function avatarContext(){const homePoint=anchor(),atHome=Math.hypot(A.x-homePoint[0],A.y-homePoint[1])<3,vertical=A.y<innerHeight*.34?'top':A.y>innerHeight*.66?'bottom':'center',horizontal=A.x<innerWidth*.34?'left':A.x>innerWidth*.66?'right':'center';return{present:true,position:atHome?'home':vertical==='center'&&horizontal==='center'?'center':vertical+'-'+horizontal,x_percent:Math.round(A.x/innerWidth*100),y_percent:Math.round(A.y/innerHeight*100)}}
function setSt(s){av.dataset.s=s}
function placeBub(){const w=bub.offsetWidth,h=bub.offsetHeight,up=A.y>innerHeight*.55;bub.style.left=cl(A.x-w+26,8,innerWidth-w-8)+'px';bub.style.top=cl(up?A.y-22*A.s-h-10:A.y+22*A.s+10,8,innerHeight-h-8)+'px'}
function chunk(t){const o=[];let c='';t.split(/(?<=[.!?])\s+/).forEach(s=>{if((c+' '+s).length>130&&c){o.push(c);c=s}else c=c?c+' '+s:s});if(c)o.push(c);return o}
let mi=0;function mouth(on){clearInterval(mi);if(on){setSt('speaking');mi=setInterval(()=>av.style.setProperty('--mo',.3+Math.random()*1.7),110)}else{av.style.setProperty('--mo',1)}}
let liveSocket=null,liveAudio=null,liveNext=0,liveNodes=new Set(),liveToken=0,playbackCancel=null,activeLive=null;
function cancelSpeech(){liveToken++;if(activeLive){const session=activeLive;activeLive=null;session.close()}if(liveSocket){try{liveSocket.close()}catch(e){}liveSocket=null}for(const n of liveNodes)try{n.stop()}catch(e){}liveNodes.clear();liveNext=liveAudio?liveAudio.currentTime:0;if(playbackCancel){const stop=playbackCancel;playbackCancel=null;stop()}else{try{AU&&AU.pause()}catch(e){}try{speechSynthesis.cancel()}catch(e){}}AU=null}
function unlockAudio(){try{if(!liveAudio)liveAudio=new(window.AudioContext||window.webkitAudioContext)();if(liveAudio.state==='suspended')liveAudio.resume().catch(()=>{})}catch(e){}}
async function speakBuffered(t,id){const r=await fetch('/api/tts',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:t})});if(!r.ok)throw Error('tts_unavailable');const j=await r.json();if(id!==liveToken)return;await new Promise((resolve,reject)=>{const audio=new Audio('data:'+j.mime+';base64,'+j.audio);AU=audio;let settled=false;const finish=error=>{if(settled)return;settled=true;if(playbackCancel===cancel)playbackCancel=null;if(AU===audio)AU=null;if(id===liveToken){mouth(false);setSt('idle')}error?reject(error):resolve()};const cancel=()=>{try{audio.pause()}catch(e){}finish()};playbackCancel=cancel;audio.onplay=()=>mouth(true);audio.onended=()=>finish();audio.onerror=()=>finish(Error('tts_playback_failed'));audio.play().catch(()=>finish(Error('tts_playback_failed')))})}
function speakB(t,id){if(!A.voice||!('speechSynthesis'in window))return Promise.resolve();return new Promise(resolve=>{try{const u=new SpeechSynthesisUtterance(t.replace(/%/g,' persen').replace(/km\/j/g,'kilometer per jam'));u.lang='id-ID';let settled=false;const finish=()=>{if(settled)return;settled=true;if(playbackCancel===cancel)playbackCancel=null;if(id===liveToken){mouth(false);setSt('idle')}resolve()};const cancel=()=>{try{speechSynthesis.cancel()}catch(e){}finish()};playbackCancel=cancel;u.onstart=()=>mouth(true);u.onend=u.onerror=finish;speechSynthesis.speak(u)}catch(e){resolve()}})}
async function speakFallback(t,id){if(SRC==='server'&&TTSOK){try{await speakBuffered(t,id);return}catch(e){}}await speakB(t,id)}
function liveSession(id){const wsUrl=(location.protocol==='https:'?'wss://':'ws://')+location.host+'/api/tts/live',socket=new WebSocket(wsUrl);liveSocket=socket;let readyResolve,readyReject,readyDone=false,current=null,closed=false,readyTimer,turnTimer;const ready=new Promise((resolve,reject)=>{readyResolve=resolve;readyReject=reject});
const settle=error=>{const task=current;if(!task)return;current=null;clearTimeout(turnTimer);error?task.reject(error):task.resolve()};
const finishTurn=()=>{if(!current||!current.done||current.pending)return;if(current.error)settle(Object.assign(current.error,{gotAudio:current.gotAudio}));else if(current.gotAudio)settle();else settle(Object.assign(Error('tts_no_audio'),{gotAudio:false}))};
const fail=error=>{if(closed)return;closed=true;clearTimeout(readyTimer);clearTimeout(turnTimer);if(!readyDone){readyDone=true;readyReject(error)}if(current){current.done=true;current.error=error;if(!current.gotAudio||id!==liveToken)settle(Object.assign(error,{gotAudio:current.gotAudio}));else finishTurn()}if(liveSocket===socket)liveSocket=null;if(socket.readyState<WebSocket.CLOSING)try{socket.close()}catch(e){}};
readyTimer=setTimeout(()=>fail(Error('tts_live_timeout')),12000);socket.onmessage=e=>{let m;try{m=JSON.parse(e.data)}catch{return fail(Error('tts_live_bad_response'))}if(m.type==='ready'){readyDone=true;clearTimeout(readyTimer);readyResolve();return}if(m.type==='error')return fail(Error(m.error||'tts_live_failed'));if(m.type==='audio'){if(!current)return fail(Error('tts_live_unexpected_audio'));try{unlockAudio();const rate=+(/rate=(\d+)/i.exec(m.mimeType||'')||[])[1]||24000,bytes=Uint8Array.from(atob(m.data),c=>c.charCodeAt(0)),samples=new Int16Array(bytes.buffer,bytes.byteOffset,Math.floor(bytes.byteLength/2));if(!samples.length)return;const task=current,buffer=liveAudio.createBuffer(1,samples.length,rate),channel=buffer.getChannelData(0);for(let i=0;i<samples.length;i++)channel[i]=samples[i]/32768;const source=liveAudio.createBufferSource();source.buffer=buffer;source.connect(liveAudio.destination);liveNodes.add(source);task.pending++;task.gotAudio=true;source.onended=()=>{liveNodes.delete(source);task.pending=Math.max(0,task.pending-1);if(current===task)finishTurn()};const start=Math.max(liveNext,liveAudio.currentTime+.02);source.start(start);liveNext=start+buffer.duration;mouth(true);clearTimeout(turnTimer);turnTimer=setTimeout(()=>fail(Error('tts_live_timeout')),30000)}catch(e){fail(Error('tts_live_playback_failed'))}return}if(m.type==='done'){if(!current)return fail(Error('tts_live_unexpected_done'));current.done=true;clearTimeout(turnTimer);finishTurn()}};
socket.onerror=()=>fail(Error('tts_live_unavailable'));socket.onclose=()=>{if(!closed)fail(Error('tts_live_closed'))};
return{async speak(text){await ready;if(closed||id!==liveToken||socket.readyState!==WebSocket.OPEN)throw Object.assign(Error('tts_live_closed'),{gotAudio:false});return new Promise((resolve,reject)=>{current={resolve,reject,pending:0,done:false,gotAudio:false,error:null};turnTimer=setTimeout(()=>fail(Error('tts_live_timeout')),30000);try{socket.send(JSON.stringify({text}))}catch(e){fail(Error('tts_live_send_failed'))}})},close(){fail(Error('tts_live_closed'))}}
}
function typeBubble(text,id){if(!$('#ob').checked)return Promise.resolve();bub.textContent='';placeBub();bub.classList.add('on');const chars=Array.from(text);return new Promise(resolve=>{let i=0;const tick=()=>{if(id!==A.q){resolve();return}bub.textContent=chars.slice(0,i).join('');if(i++>=chars.length)resolve();else setTimeout(tick,18)};tick()})}
function typeReply(text,id){const pos=A.hist.length-1,node=$('#hist').lastElementChild,chars=Array.from(text);return new Promise(resolve=>{let i=0;const tick=()=>{if(id!==A.q){try{localStorage.setItem('uf-h',JSON.stringify(A.hist.slice(-50)))}catch(e){}resolve();return}const value=chars.slice(0,++i).join('');node.textContent=value;A.hist[pos][1]=value;$('#hist').scrollTop=1e9;if(i>=chars.length){try{localStorage.setItem('uf-h',JSON.stringify(A.hist.slice(-50)))}catch(e){}resolve()}else setTimeout(tick,18)};tick()})}
$('#stp').onclick=()=>{A.request++;cancelSpeech();try{speechSynthesis.cancel()}catch(e){}A.q++;A.busy=false;bub.classList.remove('on');mouth(false);setSt('idle')};
async function say(t){cancelSpeech();const id=++A.q;msg('a','');const reply=typeReply(t,id),token=liveToken;let session=null;if(A.voice&&SRC==='server'&&TTSLIVE)try{session=liveSession(token);activeLive=session}catch(e){}for(const c of chunk(t)){if(id!==A.q)break;const typing=typeBubble(c,id);if(!A.voice){await typing;if($('#ob').checked)await wait(1800+c.length*32);bub.classList.remove('on');await wait(220);continue}if(session){try{await Promise.all([typing,session.speak(c)])}catch(e){await typing;if(id!==A.q)break;if(activeLive===session)activeLive=null;session.close();session=null;if(!e.gotAudio)await speakFallback(c,token)}}else await Promise.all([typing,speakFallback(c,token)]);if(id!==A.q)break;if($('#ob').checked){await wait(180);bub.classList.remove('on');await wait(220)}}if(session){if(activeLive===session)activeLive=null;session.close()}await reply;if(id===A.q){mouth(false);setSt('idle')}}
function msg(r,t){A.hist.push([r,t]);try{localStorage.setItem('uf-h',JSON.stringify(A.hist.slice(-50)))}catch(e){}drawH()}
function drawH(){const h=$('#hist');h.innerHTML=A.hist.map(([r,t])=>`<div class="m1 ${r}"></div>`).join('');[...h.children].forEach((e,i)=>e.textContent=A.hist[i][1]);h.scrollTop=1e9}
try{A.hist=JSON.parse(localStorage.getItem('uf-h')||'[]')}catch(e){}if(!A.hist.length)A.hist=[['a','Halo. Saya bisa membawa Anda ke ruas, jam, atau grafik yang relevan. Coba: "Bawa saya ke ruas paling macet".']];drawH();
function resetIdle(){clearTimeout(A.idle);A.idle=setTimeout(function t(){if(!$('#oa').checked)return;if(A.busy||A.open||A.hov||av.dataset.s==='speaking'){A.idle=setTimeout(t,4000);return}home()},12000)}
function openP(v){A.open=v;pn.classList.toggle('on',v);isl.classList.toggle('open',v);if(v)drawH();resetIdle()}
let dr=null;isl.onpointerdown=e=>{dr={y:e.clientY,dy:0};isl.setPointerCapture(e.pointerId);isl.classList.add('dg')};isl.onpointermove=e=>{if(!dr)return;dr.dy=e.clientY-dr.y;const d=A.open?Math.min(0,dr.dy):Math.max(0,dr.dy);isl.style.transform=`translate(-50%,${Math.sign(d)*Math.min(Math.abs(d),90)*.5}px)`};
isl.onpointerup=()=>{if(!dr)return;const d=dr.dy;isl.classList.remove('dg');isl.style.transform='';if(!A.open&&(d>36||Math.abs(d)<6))openP(true);else if(A.open&&(d<-36||Math.abs(d)<6))openP(false);dr=null};isl.onkeydown=e=>{if(e.key==='Enter')openP(!A.open)};
pn.onpointerenter=()=>A.hov=true;pn.onpointerleave=()=>A.hov=false;$('#cls').onclick=()=>openP(false);$('#gear').onclick=()=>$('#set').classList.toggle('on');
$('#vo').onclick=()=>{A.voice=!A.voice;$('#vo').innerHTML=A.voice?SPK1:SPK0;$('#vo').classList.toggle('on',A.voice);$('#vo').setAttribute('aria-pressed',A.voice);if(!A.voice)$('#stp').click()};
$('#ep').onchange=e=>A.ep=e.target.value.trim();
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR)$('#mic').style.display='none';else $('#mic').onclick=()=>{const r=new SR();r.lang='id-ID';setSt('listening');r.onresult=e=>{$('#aq').value=e.results[0][0].transcript;$('#af').requestSubmit()};r.onend=()=>setSt('idle');r.onerror=()=>msg('n','Input suara tidak tersedia.');r.start()};
$('#af').onsubmit=e=>{e.preventDefault();unlockAudio();const q=$('#aq').value;$('#aq').value='';ask(q)};$$('.ch button').forEach(b=>b.onclick=()=>{unlockAudio();ask(b.textContent)});
const TG={kpi:'#kpis',line:'#c-line',bar:'#c-bar',donut:'#c-donut',stk:'#c-stk',heat:'#c-heat',sct:'#c-sct',area:'#c-area',alerts:'#c-alerts',ana:'#c-ana',holo:'#c-holo'};
async function hl(k){const el=$(TG[k]);if(!el)return;setSt('navigating');el.scrollIntoView({behavior:RM?'auto':'smooth',block:'center'});await wait(RM?50:700);const r=el.getBoundingClientRect();moveTo(r.right-30,Math.max(r.top,80),1);el.classList.add('hl');setTimeout(()=>el.classList.remove('hl'),3400);await wait(550);setSt('idle')}
// hanya aksi yang didaftarkan; argumen divalidasi terhadap data
async function run(a){if(!a||typeof a!=='object')return;switch(a.type){case'select_kec':if(KEC.some(k=>k[0]===a.id))sel({kec:a.id,road:''});break;case'select_road':{const r=ROADS.find(x=>x.id===a.id);if(r)sel({kec:r.k,road:r.id})}break;case'set_hour':{const h1=+a.from,h2=+(a.to??a.from);if(h1>=0&&h2<=23&&h1<=h2)sel({h1,h2})}break;case'set_period':if(['day','week','month'].includes(a.value))sel({per:a.value});break;case'reset':reset();break;case'open_panel':openP(true);break;case'move_avatar':if(['top-left','top-right','bottom-left','bottom-right','center','home'].includes(a.position))moveAvatar(a.position);break;case'highlight':await hl(a.target)}}
async function exec(l){const actions=l.slice(0,40),highlights=actions.filter(a=>a?.type==='highlight'),others=actions.filter(a=>a?.type!=='highlight');for(const a of others)await run(a);for(const a of highlights)await run(a)}
async function ask(q){q=q.trim();if(!q)return;const request=++A.request;cancelSpeech();A.q++;msg('u',q);A.busy=true;setSt('thinking');await wait(650);let r;try{r=await remote(q);if(typeof r.say!=='string')throw{}}catch(e){r={say:'Maaf, asisten AI belum bisa menjawab. '+((e&&e.msg)||'Periksa konfigurasi AI di server.'),actions:[]}}if(request!==A.request)return;if(Array.isArray(r.steps)&&r.steps.length){for(const step of r.steps.slice(0,20)){if(request!==A.request)break;await exec(Array.isArray(step.actions)?step.actions:[]);if(request!==A.request)break;if(typeof step.say==='string'&&step.say.trim())await say(step.say)}}else{await exec(Array.isArray(r.actions)?r.actions:[]);if(request===A.request)await say(r.say)}if(request===A.request){A.busy=false;resetIdle()}}
async function remote(q){const[a,b]=span(),iso=i=>dt(i).toISOString().slice(0,10);const res=await fetch(A.ep||'/api/ai',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question:q,session:SID,context:{from:iso(a),to:iso(b),kec:S.kec,road:S.road,h1:S.h1,h2:S.h2,filters:S,avatar:avatarContext()}})});if(!res.ok){let m='';try{m=({ai_not_configured:'Kunci atau model AI belum diatur di server.',rate_limited:'Terlalu banyak permintaan, coba lagi sebentar.',ai_upstream_429:'Batas pakai layanan AI gratis tercapai, coba lagi nanti.',ai_upstream_404:'Nama model AI tidak dikenali, periksa AI_MODEL.',ai_bad_output:'Jawaban AI tidak dapat dibaca, coba ulangi pertanyaan.'})[(await res.json()).error]||''}catch(x){}throw{msg:m}}return res.json()}
function explainCond(i){const c=K(Q(0,true)).c;ask_local(`${ST[i]}: ${c[i].toFixed(0)}% pengamatan ruas-jam pada filter aktif. ${i===2?'Kriteria macet: kepadatan di atas 75% kapasitas.':i===1?'Kriteria padat: kepadatan 50 sampai 75%.':'Kriteria lancar: kepadatan di bawah 50%.'}`,'donut')}
async function ask_local(t,tg){A.busy=true;await hl(tg);await say(t);A.busy=false;resetIdle()}
// ---------- init
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.08});$$('.rv').forEach(e=>io.observe(e));setTimeout(()=>$$('.rv').forEach(e=>e.classList.add('in')),2500);
addEventListener('resize',()=>{A.s<1?home():moveTo(A.x,A.y,A.s)});
$$('.rv').forEach((e,i)=>e.style.setProperty('--i',i%4));$('#cta').onclick=()=>openP(true);let SRC='',AIOK=false,TTSOK=false,TTSLIVE=false,AU=null;
const SID=(()=>{try{let s=localStorage.getItem('uf-sid');if(!s){s=crypto.randomUUID();localStorage.setItem('uf-sid',s)}return s}catch(e){return'anon-session'}})();
async function loadData(){try{const[m,t,h]=await Promise.all([fetch('/api/meta'),fetch('/api/traffic'),fetch('/api/health')]);if(!m.ok||!t.ok)throw 0;const M=await m.json(),T=await t.json();
KEC=M.districts;ROADS=M.roads;BASE=Date.parse(M.min);NDAYS=Math.round((Date.parse(M.max)-BASE)/864e5)+1;D=ROADS.map(()=>Array.from({length:NDAYS},()=>Array(24).fill(null)));
T.rows.forEach(([id,d,hr,dn,v,s,ac])=>{const ri=ROADS.findIndex(x=>x.id===id);if(ri>=0&&D[ri][d])D[ri][d][hr]={dn,v,s,a:ac}});
if(D.some(r=>r.some(d=>d.some(x=>!x))))throw 1;
S.date=NDAYS-1;$('#fd').min=M.min;$('#fd').max=M.max;initFilters();SRC='server';
if(h.ok){const k=await h.json();AIOK=!!(k.ai&&k.ai.ok);TTSOK=!!k.tts;TTSLIVE=!!k.ttsLive}
$('#cap').textContent='Sumber data: Supabase PostgreSQL (data simulasi)'+(AIOK?' \u00b7 AI terhubung':' \u00b7 AI belum aktif')+(TTSOK?' \u00b7 TTS terhubung':'');render()
}catch(e){$('#hl').textContent='data tidak dapat dimuat';$('#cap').textContent='Gagal memuat data. Pastikan server.js berjalan dan supabase.sql sudah dijalankan.'}}
av.style.transition='none';home();loadData();requestAnimationFrame(()=>av.style.transition='');resetIdle();
</script></body></html>
